{
  "app": "韵动吧 Android 5.3.32",
  "origin": "https://wxapi.sports8.com.cn",
  "transport": "POST JSON，App 公共请求层附加会话信息并签名",
  "venues": {
    "venues": {
      "name": "按条件列出场馆",
      "path": "/api/ydb/stadium/v2/apiGetSearchStadiumByV2",
      "fields": [
        "cityid",
        "countyid",
        "reqKey",
        "type",
        "sort",
        "labels",
        "lat",
        "lng",
        "date",
        "timePeriod",
        "pageIndex",
        "pageSize",
        "userid"
      ],
      "result": [
        "stadiumList",
        "allStadiumList",
        "recommendStadiumList"
      ],
      "evidence": "Hermes #25767–25770。依次取首个非空列表；网球 type=0，reqKey 初值 100，首页页码 1。"
    },
    "keyword": {
      "name": "按场馆名称搜索",
      "path": "/api/ydb/seach/apiSearchKeyword",
      "fields": [
        "type",
        "keyword",
        "longitude",
        "latitude",
        "cityid",
        "pageIndex",
        "pageSize"
      ],
      "result": [
        "resultList"
      ],
      "evidence": "Hermes #25776 与搜索页。App 传 type=1，首次取 50 条，结果按 resultType=2 筛选场馆。"
    },
    "detail": {
      "name": "场馆详情",
      "path": "/api/ydb/stadium/apiGetStadiumDetail",
      "fields": [
        "stadiumid",
        "userid",
        "lat",
        "lng"
      ],
      "result": [
        "stadiumName"
      ],
      "evidence": "Hermes #25735，以及场馆页对 useGetStadiumDetail 的调用。"
    },
    "slots": {
      "name": "普通场馆排期",
      "path": "/api/ydb/stadium/apiGetStadiumShedule",
      "fields": [
        "stadiumid",
        "date",
        "userid",
        "selfflag"
      ],
      "result": [
        "dateList",
        "fieldList",
        "showhour"
      ],
      "evidence": "Hermes #30123。date 是当地零点的 Unix 秒。fieldList 的 shedule 包含场地时段。",
      "cellFields": {
        "source": "fieldList[].shedule[]",
        "startHour": "timePoint",
        "status": "status",
        "priceFields": [
          "realPrice",
          "expense"
        ]
      }
    },
    "third-party-slots": {
      "name": "第三方场馆排期",
      "path": "/StadiumHelper/third/apiv3/product/book",
      "fields": [
        "stadium_id",
        "product_id",
        "ydbsp_time",
        "select_date",
        "product_type",
        "selfflag"
      ],
      "result": [
        "booking_ground_array",
        "detail_ground_names"
      ],
      "evidence": "Hermes #30125。selfflag=2 使用此查询。book_price_infos 包含 booking_start_time、booking_price、booking_status。",
      "cellFields": {
        "court": "detail_ground_name",
        "courtId": "detail_ground_id",
        "start": "booking_start_time",
        "price": "booking_price",
        "status": "booking_status"
      }
    }
  },
  "play_list_example": {
    "url": "/YDBCLUB/service/personalCenter/activityList",
    "data": {
      "cityid": "<cityid>",
      "flag": null,
      "status": 10,
      "typecode": null,
      "stadiumid": null,
      "orderType": "1",
      "pageSize": 10,
      "method": "Android.v30",
      "page": 1
    }
  },
  "play_detail_example": {
    "url": "/YDBCLUB/service/personalCenter/activityDetail",
    "data": {
      "activityid": "<activityid>"
    }
  },
  "auth": {
    "password": "/api/ydb/account/userLogin",
    "send_sms": "/api/ydb/account/v1/apiSendMobileSms",
    "sms_login": "/api/ydb/account/quickLogin",
    "session": [
      "Authorization: Bearer",
      "appSessionId",
      "appVersion"
    ]
  }
}
